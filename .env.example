# StoryCheck AI planned environment contract; app/Compose do not exist yet.
# Copy to .env after STC-001, and supply actual installed/configured models.
APP_PORT=8080

# Ollama is installed separately on the host. In Docker the URL may need host-gateway mapping.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_1=qwen2.5:7b
OLLAMA_MODEL_2=llama3.2:3b
OLLAMA_MODEL_3=

# OpenRouter is optional and may cost money; backend only, never in browser config.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL_1=
OPENROUTER_MODEL_2=
OPENROUTER_MODEL_3=

# Target bounded timeout. The actual property mapping is implemented in STC-002.
AI_REQUEST_TIMEOUT_MS=60000
